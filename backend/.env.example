# API Keys (Required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# Security (Required)
APP_PASSWORD=your-secure-password-here

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-url.onrender.com

# Model Defaults (Optional - these are the defaults)
DEFAULT_GPT_MODEL=gpt-4o-mini
DEFAULT_CLAUDE_MODEL=claude-haiku-4-5-20251001
DEFAULT_GEMINI_MODEL=gemini-2.0-flash-exp
DEFAULT_LOCAL_MODEL=llama3

# Limits (Optional - these are the defaults)
DAILY_COST_LIMIT=5.00
MAX_CONTEXT_MESSAGES=20
IP_RATE_LIMIT=60
MAX_INPUT_CHARS=10000

# Timeouts in seconds (Optional - these are the defaults)
OPENAI_TIMEOUT=60
ANTHROPIC_TIMEOUT=60
GEMINI_TIMEOUT=60
OLLAMA_TIMEOUT=90

# Context limits in tokens (Optional - these are the defaults)
GPT_MAX_CONTEXT=128000
CLAUDE_MAX_CONTEXT=200000
GEMINI_MAX_CONTEXT=1000000

# Optional Features
USE_SYSTEM_PROMPT=false
OLLAMA_BASE_URL=http://localhost:11434
