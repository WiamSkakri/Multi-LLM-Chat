# API URL (Required)
# For local development:
NEXT_PUBLIC_API_URL=ws://localhost:8000
NEXT_PUBLIC_HTTP_API_URL=http://localhost:8000

# For production (replace with your backend URL):
# NEXT_PUBLIC_API_URL=wss://your-backend-url.onrender.com
# NEXT_PUBLIC_HTTP_API_URL=https://your-backend-url.onrender.com

# NOTE: Password is now entered via the login page UI
# No need to set NEXT_PUBLIC_APP_PASSWORD anymore
